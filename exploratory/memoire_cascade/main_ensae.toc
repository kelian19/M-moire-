\contentsline {paragraph}{Un canal se lit de trois façons, et elles ne sont pas interchangeables.}{155}{paragraph*.205}%
\contentsline {paragraph}{L'état non conforme est le \emph {coin supérieur} du pavé, et ce n'est pas une évidence mais une propriété testée.}{156}{paragraph*.206}%
\contentsline {subsection}{\numberline {C.4.1}Le test de résistance inversé}{156}{subsection.C.4.1}%
\contentsline {paragraph}{L'interaction n'est plus un résidu : elle se décompose, et elle vit aux paires.}{157}{paragraph*.207}%
\contentsline {paragraph}{Une objection à lever avant d'aller plus loin : ce treillis évalue des états incohérents.}{157}{paragraph*.208}%
\contentsline {paragraph}{Une seule paire est négative, et elle borne ce qu'on peut attribuer à la contagion.}{158}{paragraph*.209}%
\contentsline {subsection}{\numberline {C.4.2}Le retour sur investissement de la conformité}{159}{subsection.C.4.2}%
\contentsline {paragraph}{Le portage.}{159}{paragraph*.212}%
\contentsline {paragraph}{Le plancher, et il porte sur le bénéfice, non sur la durée.}{159}{paragraph*.213}%
\contentsline {paragraph}{D'où le sens de la borne, qui est l'inverse de ce qu'on lit d'abord.}{159}{paragraph*.214}%
\contentsline {paragraph}{Ce taux n'est pas un critère de décision d'investissement.}{160}{paragraph*.215}%
\contentsline {paragraph}{Une réserve sur le taux, déclarée plutôt que corrigée.}{160}{paragraph*.216}%
