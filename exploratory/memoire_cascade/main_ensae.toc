\contentsline {section}{\numberline {D.1}Le dispositif de vérification des nombres publiés}{162}{section.D.1}%
\contentsline {paragraph}{Le principe, et il tient en une phrase.}{162}{paragraph*.218}%
\contentsline {paragraph}{Il rend trois lignes, et pas une.}{162}{paragraph*.219}%
\contentsline {paragraph}{La couverture passe avant le taux, et c'est le point le moins intuitif.}{162}{paragraph*.220}%
\contentsline {paragraph}{Trois états, et un seul doit valoir zéro.}{163}{paragraph*.221}%
\contentsline {paragraph}{Ce que le harnais ne fait pas, et il faut le dire aussi nettement.}{163}{paragraph*.222}%
\contentsline {paragraph}{Le résidu se répartit en quatre classes, et une seule est un défaut.}{163}{paragraph*.223}%
\contentsline {paragraph}{Ce que le dispositif a effectivement trouvé.}{163}{paragraph*.224}%
