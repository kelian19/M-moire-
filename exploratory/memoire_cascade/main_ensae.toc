\contentsline {chapter}{\numberline {E}Le protocole d'élicitation, préparé et non exécuté}{183}{appendix.E}%
\contentsline {section}{\numberline {E.1}La méthode de Cooke, en quatre temps}{183}{section.E.1}%
\contentsline {section}{\numberline {E.2}Le protocole construit pour la matrice de contagion}{183}{section.E.2}%
\contentsline {paragraph}{Une dixième graine a été retirée, et le dire fait partie du protocole.}{184}{paragraph*.241}%
\contentsline {section}{\numberline {E.3}Pourquoi il n'a pas été exécuté}{184}{section.E.3}%
\contentsline {paragraph}{Un panel de deux experts n'a aucun pouvoir de calibration.}{184}{paragraph*.242}%
\contentsline {paragraph}{Et une élicitation faible ne serait pas neutre, elle serait trompeuse.}{184}{paragraph*.243}%
\contentsline {paragraph}{Une asymétrie à assumer, car un relecteur la trouvera.}{184}{paragraph*.244}%
\contentsline {section}{\numberline {E.4}Ce qui le remplace}{185}{section.E.4}%
\contentsline {section}{\numberline {E.5}La relecture de praticien et son résultat}{185}{section.E.5}%
\contentsline {paragraph}{Pourquoi ce dispositif est nécessaire, et il l'est pour une raison qui n'a rien de conjoncturel.}{185}{paragraph*.245}%
\contentsline {paragraph}{Le résultat nul est le premier à publier.}{185}{paragraph*.246}%
\contentsline {paragraph}{Ce que la réponse corrobore, et ce n'est pas la direction.}{186}{paragraph*.247}%
\contentsline {paragraph}{Une qualification substantielle, qu'il faut déclarer sans la traiter.}{186}{paragraph*.248}%
\contentsline {paragraph}{Et un argument d'antériorité, le seul de la réponse qui soutienne vraiment un ordre.}{186}{paragraph*.249}%
\contentsline {paragraph}{Ce que l'instrument devient.}{186}{paragraph*.250}%
\contentsline {paragraph}{Statut.}{186}{paragraph*.251}%
