\contentsline {paragraph}{Ce qui justifie le déplacement, et ce n'est pas une taille.}{121}{paragraph*.162}%
\contentsline {paragraph}{Où cet étage est publié, désormais.}{121}{paragraph*.163}%
\contentsline {paragraph}{Et ce qui ne change pas.}{121}{paragraph*.164}%
\contentsline {paragraph}{Sur l'auto-excitation, une convergence de choix et non une corroboration.}{121}{paragraph*.165}%
\contentsline {paragraph}{Ce que ce test établit réellement : une équivalence observationnelle, et c'est plus fort qu'un rejet.}{122}{paragraph*.166}%
\contentsline {section}{\numberline {11.3}De l'incertitude au chiffre reporté : VaR prédictive et VaR robuste}{123}{section.11.3}%
\contentsline {paragraph}{Les six postures, et ce que chacune intègre.}{123}{paragraph*.167}%
\contentsline {paragraph}{Quelle posture le mémoire reporte-t-il.}{124}{paragraph*.168}%
\contentsline {paragraph}{Un fait qui rend le choix moins tranché qu'il n'y paraît : la robuste à $\beta =95\,\%$ \emph {est} la borne haute de l'intervalle déjà publié.}{125}{paragraph*.171}%
\contentsline {section}{\numberline {11.4}Un défaut de calibration, chiffré plutôt que corrigé}{126}{section.11.4}%
\contentsline {paragraph}{Le sens des écarts, en deux colonnes.}{126}{paragraph*.172}%
\contentsline {paragraph}{Les deux lignes de périmètre sont d'une autre nature, et vont en sens contraire.}{128}{paragraph*.173}%
\contentsline {paragraph}{Cette limite est désormais chiffrée, et le chiffre est plus parlant que le coefficient.}{128}{paragraph*.174}%
\contentsline {paragraph}{Et le correctif a désormais une forme fonctionnelle publiée, ce qui change son statut.}{129}{paragraph*.175}%
\contentsline {paragraph}{La dernière ligne est la seule dont le sens ne se déclare pas.}{129}{paragraph*.176}%
