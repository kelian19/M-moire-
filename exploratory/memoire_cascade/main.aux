\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Diagnostic GPD sur le périmètre cyber$\times $finance d'OpRisk. \textit  {Gauche} : $\hat  {\xi }$ en fonction du seuil $u$ ; le paramètre passe sous $\xi = 1$ (espérance finie) avant le seuil retenu $u = 20$~M\officialeuro  . La plage tracée s'arrête en deçà des seuils les plus élevés du balayage en percentiles, où l'indice descend plus bas : cette figure atteste le \emph  {voisinage} du seuil, non une stabilité d'ensemble, et la décroissance complète est mesurée au \S  \ref  {soc:sec:validation}. \textit  {Droite} : le nombre d'excès correspondant ($n = 91$) demeure au-dessus du minimum de $30$ requis pour une estimation robuste.\relax }}{37}{figure.caption.55}\protected@file@percent }
\newlabel{soc:fig:diagnostic-gpd}{{5.2}{37}{Diagnostic GPD sur le périmètre cyber$\times $finance d'OpRisk. \textit {Gauche} : $\hat {\xi }$ en fonction du seuil $u$ ; le paramètre passe sous $\xi = 1$ (espérance finie) avant le seuil retenu $u = 20$~M\euro . La plage tracée s'arrête en deçà des seuils les plus élevés du balayage en percentiles, où l'indice descend plus bas : cette figure atteste le \emph {voisinage} du seuil, non une stabilité d'ensemble, et la décroissance complète est mesurée au \S \ref {soc:sec:validation}. \textit {Droite} : le nombre d'excès correspondant ($n = 91$) demeure au-dessus du minimum de $30$ requis pour une estimation robuste.\relax }{figure.caption.55}{}}
\newlabel{soc:eq:hill}{{5.17}{37}{L'estimateur de Hill : définition et rôle diagnostique}{equation.5.5.17}{}}
\@writefile{toc}{\contentsline {paragraph}{Application et confrontation au MLE-GPD.}{37}{paragraph*.57}\protected@file@percent }
