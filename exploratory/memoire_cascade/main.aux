\@writefile{lof}{\contentsline {figure}{\numberline {9.1}{\ignorespaces Identification partielle de la contagion dirigée : le résultat central du mémoire. \textbf  {(a)}~Le coût de la donnée manquante, les bornes se resserrant à mesure que l'ignorance directionnelle $t$ diminue ; c'est cette pente qui chiffre en euros ce qu'un registre mieux spécifié apporterait. \textbf  {(b)}~La lecture centrale du prior d'expert, à l'intérieur de bornes qui, elles, n'en dépendent pas : c'est ce qui rend le résultat opposable sans élicitation. \textbf  {(c)}~La priorité de remédiation robuste, au sens du regret maximal. \textbf  {(d)}~La dominance majoritaire entre piliers sur l'ensemble admissible : P5 n'arrive jamais en tête, et P1 et P4 concentrent $81\,\%$ des configurations. Sources : scripts~\texttt  {30} et~\texttt  {67}.\relax }}{73}{figure.caption.92}\protected@file@percent }
\newlabel{fig:partielle}{{9.1}{73}{Identification partielle de la contagion dirigée : le résultat central du mémoire. \textbf {(a)}~Le coût de la donnée manquante, les bornes se resserrant à mesure que l'ignorance directionnelle $t$ diminue ; c'est cette pente qui chiffre en euros ce qu'un registre mieux spécifié apporterait. \textbf {(b)}~La lecture centrale du prior d'expert, à l'intérieur de bornes qui, elles, n'en dépendent pas : c'est ce qui rend le résultat opposable sans élicitation. \textbf {(c)}~La priorité de remédiation robuste, au sens du regret maximal. \textbf {(d)}~La dominance majoritaire entre piliers sur l'ensemble admissible : P5 n'arrive jamais en tête, et P1 et P4 concentrent $81\,\%$ des configurations. Sources : scripts~\texttt {30} et~\texttt {67}.\relax }{figure.caption.92}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.2}{\ignorespaces Poser $W$ ou le borner, comparés avant élicitation. (a)~Un point contre un socle et des bornes. (b)~Seule la part supérieure dépend de l'élicitation. (c)~Le régime~A suit le biais du panel, la bande du régime~B ne bouge pas. (d)~Ce que l'élicitation doit départager, et rien de plus.\relax }}{74}{figure.caption.93}\protected@file@percent }
\newlabel{fig:regimes}{{9.2}{74}{Poser $W$ ou le borner, comparés avant élicitation. (a)~Un point contre un socle et des bornes. (b)~Seule la part supérieure dépend de l'élicitation. (c)~Le régime~A suit le biais du panel, la bande du régime~B ne bouge pas. (d)~Ce que l'élicitation doit départager, et rien de plus.\relax }{figure.caption.93}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.3}{\ignorespaces L'échelle de repli sur $u_{ij}$. (a)~Les bornes de capital se resserrent quand on recule d'un cran (hypothèse de structure). (b)~Un rang $1$ capte $74\,\%$ de la direction posée. (c)~Ce que la direction change à la décision : au cran nul, les gains de remédiation de P1 et P4 se rejoignent.\relax }}{74}{figure.caption.94}\protected@file@percent }
\newlabel{fig:echelle}{{9.3}{74}{L'échelle de repli sur $u_{ij}$. (a)~Les bornes de capital se resserrent quand on recule d'un cran (hypothèse de structure). (b)~Un rang $1$ capte $74\,\%$ de la direction posée. (c)~Ce que la direction change à la décision : au cran nul, les gains de remédiation de P1 et P4 se rejoignent.\relax }{figure.caption.94}{}}
