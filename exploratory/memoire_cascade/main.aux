\@writefile{lof}{\contentsline {figure}{\numberline {10.11}{\ignorespaces Le besoin de capital \textsc  {orsa} au titre de \textsc  {dora}, sur quatre bilans réels et à partir des seuls chiffres \textsc  {sfcr} publiés. Les entités sont désignées par leur classe de taille, le modèle n'utilisant que le bilan et jamais l'identité. \textbf  {(a)}~les quatre entités lues sur la courbe d'élasticité du panel, l'entité notionnelle du mémoire tombant au milieu d'elles. \textbf  {(b)}~le besoin et sa bande d'identification face à la charge forfaitaire, en échelle logarithmique : le forfait croît avec les provisions, la charge de contagion beaucoup moins vite, et c'est tout le sujet. \textbf  {(c)}~le besoin rapporté au \textsc  {scr} publié, à titre de mise à l'échelle et non de décomposition, révèle une borne inférieure de validité de la transposition, que le mémoire publie plutôt que de la laisser découvrir. Source : script~\texttt  {65}.\relax }}{92}{figure.caption.126}\protected@file@percent }
\newlabel{fig:entites-reelles}{{10.11}{92}{Le besoin de capital \textsc {orsa} au titre de \textsc {dora}, sur quatre bilans réels et à partir des seuls chiffres \textsc {sfcr} publiés. Les entités sont désignées par leur classe de taille, le modèle n'utilisant que le bilan et jamais l'identité. \textbf {(a)}~les quatre entités lues sur la courbe d'élasticité du panel, l'entité notionnelle du mémoire tombant au milieu d'elles. \textbf {(b)}~le besoin et sa bande d'identification face à la charge forfaitaire, en échelle logarithmique : le forfait croît avec les provisions, la charge de contagion beaucoup moins vite, et c'est tout le sujet. \textbf {(c)}~le besoin rapporté au \textsc {scr} publié, à titre de mise à l'échelle et non de décomposition, révèle une borne inférieure de validité de la transposition, que le mémoire publie plutôt que de la laisser découvrir. Source : script~\texttt {65}.\relax }{figure.caption.126}{}}
