\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Validation du socle. \textbf  {(a-b)} QQ-plot et PP-plot de la sévérité contre la GPD ajustée. \textbf  {(c)} vie résiduelle moyenne, linéaire au-delà de $u$. \textbf  {(d)} stabilité de $\hat  \xi $ au seuil. \textbf  {(e)} test d'Anderson-Darling, loi nulle par bootstrap paramétrique et statistique observée ($p=0{,}96$). \textbf  {(f)} adéquation de la fréquence : la NB colle aux comptes firme-année, le Poisson rate la queue. Source : script~\texttt  {47}.\relax }}{40}{figure.caption.61}\protected@file@percent }
\newlabel{soc:fig:validation}{{5.4}{40}{Validation du socle. \textbf {(a-b)} QQ-plot et PP-plot de la sévérité contre la GPD ajustée. \textbf {(c)} vie résiduelle moyenne, linéaire au-delà de $u$. \textbf {(d)} stabilité de $\hat \xi $ au seuil. \textbf {(e)} test d'Anderson-Darling, loi nulle par bootstrap paramétrique et statistique observée ($p=0{,}96$). \textbf {(f)} adéquation de la fréquence : la NB colle aux comptes firme-année, le Poisson rate la queue. Source : script~\texttt {47}.\relax }{figure.caption.61}{}}
