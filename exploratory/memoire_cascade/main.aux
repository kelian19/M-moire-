\@writefile{lof}{\contentsline {figure}{\numberline {8.5}{\ignorespaces Le corpus étendu et la matrice ordonnée $p_{jk}$. \textbf  {(a)}~la matrice complète des médianes a posteriori, ligne émettrice et colonne réceptrice : la ligne de $P_2$ et la colonne de $P_1$ sont vides, ce qui est la traduction chiffrée du puits et de la source pure. \textbf  {(b)}~les dix premiers liens ordonnés avec leur crédible à $90\,\%$ : la direction ressort, l'amplitude reste large et aucun crédible ne passe entièrement au-dessus de $0{,}5$. \textbf  {(c)}~sensibilité à la sous-documentation des défaillances non propagées : le niveau s'effondre, la part de direction tient. Source : script~\texttt  {59}.\relax }}{62}{figure.caption.80}\protected@file@percent }
\newlabel{fig:corpus-etendu}{{8.5}{62}{Le corpus étendu et la matrice ordonnée $p_{jk}$. \textbf {(a)}~la matrice complète des médianes a posteriori, ligne émettrice et colonne réceptrice : la ligne de $P_2$ et la colonne de $P_1$ sont vides, ce qui est la traduction chiffrée du puits et de la source pure. \textbf {(b)}~les dix premiers liens ordonnés avec leur crédible à $90\,\%$ : la direction ressort, l'amplitude reste large et aucun crédible ne passe entièrement au-dessus de $0{,}5$. \textbf {(c)}~sensibilité à la sous-documentation des défaillances non propagées : le niveau s'effondre, la part de direction tient. Source : script~\texttt {59}.\relax }{figure.caption.80}{}}
