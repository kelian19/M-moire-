\@writefile{toc}{\contentsline {paragraph}{Le niveau de propagation est le levier le \emph  {moins} sensible des quatre.}{82}{paragraph*.108}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Et la thèse ne dépend pas des trois valeurs posées.}{83}{paragraph*.109}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{La direction, elle, ne se stresse pas : elle se borne, et la borne se gradue.}{83}{paragraph*.110}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Enfin, la décomposition de l'écart a son propre bruit, et il est publié.}{83}{paragraph*.111}\protected@file@percent }
