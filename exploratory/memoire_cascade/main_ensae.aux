\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces La thèse ne dépend pas des valeurs de $g$, seulement de leur ordre. \textbf  {(a)}~le lemme de monotonie sur vingt points de grille, à nombres aléatoires communs, avec les trois valeurs retenues situées sur la courbe et la charge forfaitaire qui, elle, ne dépend pas de l'état. \textbf  {(b)}~cinq applications état $\to g$, de très étroite à large : l'ordre du capital est respecté par toutes, le forfait reste plat dans tous les cas. \textbf  {(c)}~l'amplitude de l'écart en fonction du seul écartement $g_{NC}-g_C$, la valeur retenue étant marquée : c'est la seule grandeur qui soit un scénario. Sources : scripts~\texttt  {66} et~\texttt  {67}.\relax }}{63}{figure.caption.89}\protected@file@percent }
\newlabel{fig:invariance-g}{{7.1}{63}{La thèse ne dépend pas des valeurs de $g$, seulement de leur ordre. \textbf {(a)}~le lemme de monotonie sur vingt points de grille, à nombres aléatoires communs, avec les trois valeurs retenues situées sur la courbe et la charge forfaitaire qui, elle, ne dépend pas de l'état. \textbf {(b)}~cinq applications état $\to g$, de très étroite à large : l'ordre du capital est respecté par toutes, le forfait reste plat dans tous les cas. \textbf {(c)}~l'amplitude de l'écart en fonction du seul écartement $g_{NC}-g_C$, la valeur retenue étant marquée : c'est la seule grandeur qui soit un scénario. Sources : scripts~\texttt {66} et~\texttt {67}.\relax }{figure.caption.89}{}}
