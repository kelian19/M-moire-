\@writefile{lof}{\contentsline {figure}{\numberline {8.6}{\ignorespaces Le biais de narration, mesuré au lieu d'être déclaré. \textbf  {(a)}~jackknife par incident : aucun rapport ne porte le signal à lui seul, les dix retraits laissant $p \leq 2{,}4\cdot 10^{-4}$. \textbf  {(b)}~point de rupture, en $p$-valeur exacte et non en $z$ : il faudrait quatre arêtes de $P_1$ retournées dans la pire configuration pour perdre la significativité, et aucun nombre de retraits n'y suffit. La courbe de retournement remonte au-delà de sept parce que retourner \emph  {toutes} les arêtes n'efface pas l'asymétrie, elle l'inverse. \textbf  {(c)}~le niveau de capital résiste, y compris avec $P_1$ rendue muette, et la bande d'identification se resserre à mesure que l'émission de $P_1$ disparaît. Source : script~\texttt  {64}.\relax }}{79}{figure.caption.106}\protected@file@percent }
\newlabel{fig:biais-narration}{{8.6}{79}{Le biais de narration, mesuré au lieu d'être déclaré. \textbf {(a)}~jackknife par incident : aucun rapport ne porte le signal à lui seul, les dix retraits laissant $p \leq 2{,}4\cdot 10^{-4}$. \textbf {(b)}~point de rupture, en $p$-valeur exacte et non en $z$ : il faudrait quatre arêtes de $P_1$ retournées dans la pire configuration pour perdre la significativité, et aucun nombre de retraits n'y suffit. La courbe de retournement remonte au-delà de sept parce que retourner \emph {toutes} les arêtes n'efface pas l'asymétrie, elle l'inverse. \textbf {(c)}~le niveau de capital résiste, y compris avec $P_1$ rendue muette, et la bande d'identification se resserre à mesure que l'émission de $P_1$ disparaît. Source : script~\texttt {64}.\relax }{figure.caption.106}{}}
