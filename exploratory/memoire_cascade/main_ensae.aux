\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces La loi de comptage négative binomiale, simulée et réconciliée. (a)~à moyenne égale, la queue du nombre annuel diffère selon la loi de mélange. (b)~la charge lognormale $a$ et le facteur $\varphi $ tracent la même surdispersion agrégée ; les deux valeurs posées quasi coïncident. (c)~le comptage déplace la VaR, pas la moyenne. Source : script~\texttt  {41}.\relax }}{41}{figure.caption.56}\protected@file@percent }
\newlabel{soc:fig:nb}{{5.1}{41}{La loi de comptage négative binomiale, simulée et réconciliée. (a)~à moyenne égale, la queue du nombre annuel diffère selon la loi de mélange. (b)~la charge lognormale $a$ et le facteur $\varphi $ tracent la même surdispersion agrégée ; les deux valeurs posées quasi coïncident. (c)~le comptage déplace la VaR, pas la moyenne. Source : script~\texttt {41}.\relax }{figure.caption.56}{}}
