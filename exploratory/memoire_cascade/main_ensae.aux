\@writefile{lof}{\contentsline {figure}{\numberline {9.1}{\ignorespaces Identification partielle de la contagion dirigée : le résultat central du mémoire. \textbf  {(a)}~Le coût de la donnée manquante, les bornes se resserrant à mesure que l'ignorance directionnelle $t$ diminue ; c'est cette pente qui chiffre en euros ce qu'un registre mieux spécifié apporterait. \textbf  {(b)}~La lecture centrale du prior d'expert, à l'intérieur de bornes qui, elles, n'en dépendent pas, de sorte que le résultat reste opposable sans élicitation. \textbf  {(c)}~La priorité de remédiation robuste, au sens du regret maximal. \textbf  {(d)}~La dominance majoritaire entre piliers sur l'ensemble admissible : P5 n'arrive jamais en tête, et P1 et P4 concentrent $81\,\%$ des configurations. Sources : scripts~\texttt  {30} et~\texttt  {67}.\relax }}{87}{figure.caption.114}\protected@file@percent }
\newlabel{fig:partielle}{{9.1}{87}{Identification partielle de la contagion dirigée : le résultat central du mémoire. \textbf {(a)}~Le coût de la donnée manquante, les bornes se resserrant à mesure que l'ignorance directionnelle $t$ diminue ; c'est cette pente qui chiffre en euros ce qu'un registre mieux spécifié apporterait. \textbf {(b)}~La lecture centrale du prior d'expert, à l'intérieur de bornes qui, elles, n'en dépendent pas, de sorte que le résultat reste opposable sans élicitation. \textbf {(c)}~La priorité de remédiation robuste, au sens du regret maximal. \textbf {(d)}~La dominance majoritaire entre piliers sur l'ensemble admissible : P5 n'arrive jamais en tête, et P1 et P4 concentrent $81\,\%$ des configurations. Sources : scripts~\texttt {30} et~\texttt {67}.\relax }{figure.caption.114}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.2}{\ignorespaces Poser $W$ ou le borner, comparés avant élicitation. (a)~Un point contre un socle et des bornes. (b)~Seule la part supérieure dépend de l'élicitation. (c)~Le régime~A suit le biais du panel, la bande du régime~B ne bouge pas. (d)~Ce que l'élicitation doit départager, et rien de plus.\relax }}{88}{figure.caption.115}\protected@file@percent }
\newlabel{fig:regimes}{{9.2}{88}{Poser $W$ ou le borner, comparés avant élicitation. (a)~Un point contre un socle et des bornes. (b)~Seule la part supérieure dépend de l'élicitation. (c)~Le régime~A suit le biais du panel, la bande du régime~B ne bouge pas. (d)~Ce que l'élicitation doit départager, et rien de plus.\relax }{figure.caption.115}{}}
