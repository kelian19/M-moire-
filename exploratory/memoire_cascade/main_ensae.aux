\@writefile{toc}{\contentsline {section}{\numberline {10.7}La sensibilité aux probabilités de propagation, prise pour elle-même}{100}{section.10.7}\protected@file@percent }
\newlabel{sec:sensibilite-propagation}{{10.7}{100}{La sensibilité aux probabilités de propagation, prise pour elle-même}{section.10.7}{}}
\@writefile{toc}{\contentsline {paragraph}{Pourquoi cette sensibilité n'est pas conduite par indices de Sobol.}{100}{paragraph*.131}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Le niveau de propagation est le levier le \emph  {moins} sensible des quatre.}{100}{paragraph*.132}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Deux défauts de ce tornado, et une renormalisation qui les corrige.}{100}{paragraph*.133}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Ce qui survit à la renormalisation, et c'est l'essentiel.}{101}{paragraph*.134}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Une dernière asymétrie, qui n'est pas de calcul mais de statut.}{101}{paragraph*.135}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Et la thèse ne dépend pas des trois valeurs posées.}{101}{paragraph*.136}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{La direction, elle, ne se stresse pas : elle se borne, et la borne se gradue.}{102}{paragraph*.137}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Enfin, la décomposition de l'écart a son propre bruit, et il est publié.}{102}{paragraph*.138}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{La même conclusion par un chemin indépendant : l'ablation en échelle.}{102}{paragraph*.139}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Et sur ce classement, le préprint de cascade climatique dit l'inverse : il faut le dire, et l'expliquer.}{103}{paragraph*.140}\protected@file@percent }
\citation{ccrn2026}
