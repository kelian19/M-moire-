\newlabel{sec:ann-corrections-instrument}{{D.12}{175}{Deux corrections d'instrument : le tornado et l'objet de l'invariance}{section.D.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {D.6}{\ignorespaces Le tornado renormalisé. \textbf  {(a)}~les élasticités, sans dimension et sans plage, avec le statut de chaque paramètre : deux des leviers sont \emph  {posés} et n'ont donc aucun intervalle d'estimation, si bien que leur barre d'origine était un choix d'affichage. \textbf  {(b)}~la décomposition du levier \@FB@og  seuil\@FB@fg  \relax {} : l'indice de queue seul dépasse le paquet entier, ce qui n'est possible que si les composantes se compensent. Source : script~\texttt  {76}.\relax }}{176}{figure.caption.232}\protected@file@percent }
\newlabel{fig:tornado-normalise}{{D.6}{176}{Le tornado renormalisé. \textbf {(a)}~les élasticités, sans dimension et sans plage, avec le statut de chaque paramètre : deux des leviers sont \emph {posés} et n'ont donc aucun intervalle d'estimation, si bien que leur barre d'origine était un choix d'affichage. \textbf {(b)}~la décomposition du levier \og seuil\fg {} : l'indice de queue seul dépasse le paquet entier, ce qui n'est possible que si les composantes se compensent. Source : script~\texttt {76}.\relax }{figure.caption.232}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {D.7}{\ignorespaces Les deux objets. \textbf  {(a)}~la moyenne des VaR conditionnelles et le quantile de la loi mélangée diffèrent de $9{,}3\,\%$, ce qui impose de dire lequel est publié. \textbf  {(b)}~sur le balayage, l'espérance ne bouge pas et le déplacement du quantile est du même ordre que le bruit de tirage, sans être monotone : il n'est pas résolu. L'échelle est celle de la bande d'identification déjà publiée, faute de quoi des écarts de quelques centaines de millions paraîtraient considérables. Source : script~\texttt  {77}.\relax }}{177}{figure.caption.233}\protected@file@percent }
\newlabel{fig:var-melange}{{D.7}{177}{Les deux objets. \textbf {(a)}~la moyenne des VaR conditionnelles et le quantile de la loi mélangée diffèrent de $9{,}3\,\%$, ce qui impose de dire lequel est publié. \textbf {(b)}~sur le balayage, l'espérance ne bouge pas et le déplacement du quantile est du même ordre que le bruit de tirage, sans être monotone : il n'est pas résolu. L'échelle est celle de la bande d'identification déjà publiée, faute de quoi des écarts de quelques centaines de millions paraîtraient considérables. Source : script~\texttt {77}.\relax }{figure.caption.233}{}}
\@writefile{toc}{\contentsline {section}{\numberline {D.13}Le plafond de sévérité, mesuré sur les quatre bilans réels}{177}{section.D.13}\protected@file@percent }
\newlabel{sec:ann-plafond}{{D.13}{177}{Le plafond de sévérité, mesuré sur les quatre bilans réels}{section.D.13}{}}
\@writefile{toc}{\contentsline {paragraph}{Une précaution de méthode, et elle vaut d'être lue.}{177}{paragraph*.235}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {D.8}{\ignorespaces Le plafond de sévérité adossé à l'exposition. \textbf  {(a)}~la prédiction naturelle, le quantile annuel borné par le plafond au titre du principe de la perte unique dominante, ne tient qu'à plafond \emph  {lâche} : plafonner détruit la queue lourde que ce principe suppose, et la charge redevient un cumul. \textbf  {(b)}~en gris, la fraction du bilan qu'un sinistre unique devrait détruire pour que le besoin publié soit atteignable ; en orange, le plafond qui ampute ce besoin de moitié. L'écart entre les deux barres est ce qui met la plus petite entité hors domaine, et l'entité la plus grande n'est amputée par aucun plafond discutable. Source : script~\texttt  {78}.\relax }}{178}{figure.caption.234}\protected@file@percent }
\newlabel{fig:plafond-exposition}{{D.8}{178}{Le plafond de sévérité adossé à l'exposition. \textbf {(a)}~la prédiction naturelle, le quantile annuel borné par le plafond au titre du principe de la perte unique dominante, ne tient qu'à plafond \emph {lâche} : plafonner détruit la queue lourde que ce principe suppose, et la charge redevient un cumul. \textbf {(b)}~en gris, la fraction du bilan qu'un sinistre unique devrait détruire pour que le besoin publié soit atteignable ; en orange, le plafond qui ampute ce besoin de moitié. L'écart entre les deux barres est ce qui met la plus petite entité hors domaine, et l'entité la plus grande n'est amputée par aucun plafond discutable. Source : script~\texttt {78}.\relax }{figure.caption.234}{}}
