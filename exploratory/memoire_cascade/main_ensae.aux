\@writefile{toc}{\contentsline {paragraph}{Le principe, et il tient en une phrase.}{162}{paragraph*.218}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Il rend trois lignes, et pas une.}{162}{paragraph*.219}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{La couverture passe avant le taux, et c'est le point le moins intuitif.}{162}{paragraph*.220}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Trois états, et un seul doit valoir zéro.}{163}{paragraph*.221}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Ce que le harnais ne fait pas, et il faut le dire aussi nettement.}{163}{paragraph*.222}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Le résidu se répartit en quatre classes, et une seule est un défaut.}{163}{paragraph*.223}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Ce que le dispositif a effectivement trouvé.}{163}{paragraph*.224}\protected@file@percent }
