\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Validation du socle. \textbf  {(a-b)} QQ-plot et PP-plot de la sévérité contre la GPD ajustée. \textbf  {(c)} vie résiduelle moyenne, linéaire au-delà de $u$. \textbf  {(d)} stabilité de $\hat  \xi $ au seuil. \textbf  {(e)} test d'Anderson-Darling, loi nulle par bootstrap paramétrique et statistique observée ($p=0{,}96$). \textbf  {(f)} adéquation de la fréquence : la NB colle aux comptes firme-année, le Poisson rate la queue. Sources : scripts~\texttt  {47} et~\texttt  {93} (règles de sélection du seuil).\relax }}{46}{figure.caption.67}\protected@file@percent }
\newlabel{soc:fig:validation}{{5.4}{46}{Validation du socle. \textbf {(a-b)} QQ-plot et PP-plot de la sévérité contre la GPD ajustée. \textbf {(c)} vie résiduelle moyenne, linéaire au-delà de $u$. \textbf {(d)} stabilité de $\hat \xi $ au seuil. \textbf {(e)} test d'Anderson-Darling, loi nulle par bootstrap paramétrique et statistique observée ($p=0{,}96$). \textbf {(f)} adéquation de la fréquence : la NB colle aux comptes firme-année, le Poisson rate la queue. Sources : scripts~\texttt {47} et~\texttt {93} (règles de sélection du seuil).\relax }{figure.caption.67}{}}
