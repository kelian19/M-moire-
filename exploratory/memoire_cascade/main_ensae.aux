\@writefile{lof}{\contentsline {figure}{\numberline {10.10}{\ignorespaces Benchmark externe : la confrontation au réel, à deux échelles qu'il ne faut pas confondre. \textbf  {(a)}~au niveau du \emph  {sinistre unique}, nos quantiles (quantile de sévérité $663$~M\officialeuro  {} et moyenne de queue $1\,752$~M\officialeuro  {} à $99{,}5\,\%$, et non des capitaux) s'insèrent parmi les grandes pertes cyber réelles, encadrant Merck-NotPetya, Equifax et Change Healthcare tout en restant sous le choc systémique NotPetya : la brique de sévérité est crédible. \textbf  {(b)}~à l'échelle \emph  {annuelle}, le capital est d'ordre systémique, comparable au marché cyber mondial, et domine de loin la charge de Formule Standard. C'est l'agrégation à une fréquence sectorielle, non la sévérité, qui porte l'agrégat à une échelle de secteur. Source : script~\texttt  {49}.\relax }}{110}{figure.caption.154}\protected@file@percent }
\newlabel{fig:benchmark-externe}{{10.10}{110}{Benchmark externe : la confrontation au réel, à deux échelles qu'il ne faut pas confondre. \textbf {(a)}~au niveau du \emph {sinistre unique}, nos quantiles (quantile de sévérité $663$~M\euro {} et moyenne de queue $1\,752$~M\euro {} à $99{,}5\,\%$, et non des capitaux) s'insèrent parmi les grandes pertes cyber réelles, encadrant Merck-NotPetya, Equifax et Change Healthcare tout en restant sous le choc systémique NotPetya : la brique de sévérité est crédible. \textbf {(b)}~à l'échelle \emph {annuelle}, le capital est d'ordre systémique, comparable au marché cyber mondial, et domine de loin la charge de Formule Standard. C'est l'agrégation à une fréquence sectorielle, non la sévérité, qui porte l'agrégat à une échelle de secteur. Source : script~\texttt {49}.\relax }{figure.caption.154}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10.11}Quatre entités réelles, et la borne inférieure de la méthode}{111}{section.10.11}\protected@file@percent }
\newlabel{sec:entites-reelles}{{10.11}{111}{Quatre entités réelles, et la borne inférieure de la méthode}{section.10.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10.12}Détenir ou transférer : le SCR confronté au prix de marché du risque}{112}{section.10.12}\protected@file@percent }
\newlabel{sec:detenir-transferer}{{10.12}{112}{Détenir ou transférer : le SCR confronté au prix de marché du risque}{section.10.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.11}{\ignorespaces Le besoin de capital \textsc  {orsa} au titre de \textsc  {dora}, sur quatre bilans réels et à partir des seuls chiffres \textsc  {sfcr} publiés. Les entités sont désignées par leur classe de taille, le modèle n'utilisant que le bilan et jamais l'identité. \textbf  {(a)}~les quatre entités lues sur la courbe d'élasticité du panel, l'entité notionnelle du mémoire tombant au milieu d'elles. \textbf  {(b)}~le besoin et sa bande d'identification face à la charge forfaitaire, en échelle logarithmique : le forfait croît avec les provisions, la charge de contagion beaucoup moins vite, et c'est tout le sujet. \textbf  {(c)}~le besoin rapporté au \textsc  {scr} publié, à titre de mise à l'échelle et non de décomposition, révèle une borne inférieure de validité de la transposition, que le mémoire publie plutôt que de la laisser découvrir. Source : script~\texttt  {65}.\relax }}{113}{figure.caption.155}\protected@file@percent }
\newlabel{fig:entites-reelles}{{10.11}{113}{Le besoin de capital \textsc {orsa} au titre de \textsc {dora}, sur quatre bilans réels et à partir des seuls chiffres \textsc {sfcr} publiés. Les entités sont désignées par leur classe de taille, le modèle n'utilisant que le bilan et jamais l'identité. \textbf {(a)}~les quatre entités lues sur la courbe d'élasticité du panel, l'entité notionnelle du mémoire tombant au milieu d'elles. \textbf {(b)}~le besoin et sa bande d'identification face à la charge forfaitaire, en échelle logarithmique : le forfait croît avec les provisions, la charge de contagion beaucoup moins vite, et c'est tout le sujet. \textbf {(c)}~le besoin rapporté au \textsc {scr} publié, à titre de mise à l'échelle et non de décomposition, révèle une borne inférieure de validité de la transposition, que le mémoire publie plutôt que de la laisser découvrir. Source : script~\texttt {65}.\relax }{figure.caption.155}{}}
\@writefile{toc}{\contentsline {paragraph}{Le multiple de capital, et ce qu'il coûte.}{114}{paragraph*.156}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Le dimensionnement, plutôt que le tout ou rien.}{114}{paragraph*.157}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Ce que la conformité change à l'arbitrage.}{114}{paragraph*.158}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.12}{\ignorespaces Détenir ou transférer : le SCR confronté au prix de marché du même risque, à l'échelle d'entité corrigée. \textbf  {(a)}~le coût annuel du capital ($8{,}0$~M\officialeuro  {} au taux révisé de $4{,}75\,\%$) vaut $2{,}2$ fois la sinistralité attendue ($3{,}6$~M\officialeuro  {}) : c'est ce rapport, absent de toute comparaison de niveau, qui rend le transfert pertinent. \textbf  {(b)}~le coût total, prime plus coût du capital résiduel, en fonction de la portée $L$ du traité en excès de perte ; l'optimum tombe en $L^\star =\mathrm  {SCR}=169$~M\officialeuro  , là où le capital résiduel s'annule. \textbf  {(c)}~ce que le dimensionnement fait gagner, $-64\,\%$, chiffre à lire comme une \emph  {borne supérieure} : capacité de marché, exclusions et risque de contrepartie l'entament, mais il faudrait $78\,\%$ d'inefficacité pour renverser la conclusion. Source : script~\texttt  {58}.\relax }}{115}{figure.caption.159}\protected@file@percent }
\newlabel{fig:detenir}{{10.12}{115}{Détenir ou transférer : le SCR confronté au prix de marché du même risque, à l'échelle d'entité corrigée. \textbf {(a)}~le coût annuel du capital ($8{,}0$~M\euro {} au taux révisé de $4{,}75\,\%$) vaut $2{,}2$ fois la sinistralité attendue ($3{,}6$~M\euro {}) : c'est ce rapport, absent de toute comparaison de niveau, qui rend le transfert pertinent. \textbf {(b)}~le coût total, prime plus coût du capital résiduel, en fonction de la portée $L$ du traité en excès de perte ; l'optimum tombe en $L^\star =\mathrm {SCR}=169$~M\euro , là où le capital résiduel s'annule. \textbf {(c)}~ce que le dimensionnement fait gagner, $-64\,\%$, chiffre à lire comme une \emph {borne supérieure} : capacité de marché, exclusions et risque de contrepartie l'entament, mais il faudrait $78\,\%$ d'inefficacité pour renverser la conclusion. Source : script~\texttt {58}.\relax }{figure.caption.159}{}}
