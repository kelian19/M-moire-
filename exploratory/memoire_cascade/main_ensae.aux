\newlabel{soc:sec:backtest}{{5.7}{47}{Le socle hors échantillon : un backtest à origine glissante}{section.5.7}{}}
\@writefile{toc}{\contentsline {paragraph}{La loi de fréquence est validée, et c'est le résultat le plus net.}{48}{paragraph*.69}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{La forme de la queue survit, et ce n'était pas acquis.}{48}{paragraph*.70}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Les quantiles, en revanche, sont dépassés trois fois trop souvent.}{48}{paragraph*.71}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Ce que cette dérive coûte, chiffré plutôt que corrigé.}{48}{paragraph*.72}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Mais la dérive n'est pas la même selon l'endroit de la distribution, ce qui modère le paragraphe précédent.}{48}{paragraph*.73}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Une conséquence sur l'indice de queue publié, et elle va en sens contraire.}{49}{paragraph*.74}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{L'effet sur l'écart entre états est mesuré, et l'argument attendu ne vaut que pour l'échelle.}{49}{paragraph*.75}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{L'écart en euros, lui, bouge à peine, mais par compensation et non par insensibilité.}{49}{paragraph*.76}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Le test se poursuit sur la charge annuelle agrégée, et il ne donne pas le même verdict.}{49}{paragraph*.77}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Le rejet n'est pourtant pas structurel : c'est la dérive, vue sur l'objet qui porte le capital.}{50}{paragraph*.78}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Un résultat inattendu au passage : la loi de comptage est décisive sur les comptes et presque immatérielle sur la charge.}{50}{paragraph*.79}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{L'indépendance entre fréquence et sévérité cesse d'être une hypothèse non testée, et elle tient.}{50}{paragraph*.80}\protected@file@percent }
