\contentsline {paragraph}{Un canal se lit de trois façons, et elles ne sont pas interchangeables.}{122}{paragraph*.157}%
\contentsline {paragraph}{L'interaction n'est plus un résidu : elle se décompose, et elle vit aux paires.}{122}{paragraph*.158}%
\contentsline {paragraph}{Une seule paire est négative, et elle borne ce qu'on peut attribuer à la contagion.}{122}{paragraph*.159}%
