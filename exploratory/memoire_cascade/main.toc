\contentsline {paragraph}{Le portage.}{123}{paragraph*.162}%
\contentsline {paragraph}{Le plancher, et il porte sur le bénéfice, non sur la durée.}{124}{paragraph*.163}%
\contentsline {paragraph}{D'où le sens de la borne, qui est l'inverse de ce qu'on lit d'abord.}{124}{paragraph*.164}%
\contentsline {paragraph}{Une réserve sur le taux, déclarée plutôt que corrigée.}{124}{paragraph*.165}%
