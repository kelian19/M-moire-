# ===== DONNÉES SENSIBLES — NE JAMAIS POUSSER =====
data/raw/
*.xlsx
*.csv
*.sas7bdat
*.parquet
*.pkl
*.feather

# Exceptions : fichiers de config non sensibles
!data/raw/.gitkeep
!data/processed/.gitkeep

# Exception : chantier exploratoire (modèle qualitatif DORA, sorties NON sensibles)
!exploratory/*.xlsx
!exploratory/**/*.xlsx

# ===== PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.eggs/

# ===== JUPYTER =====
.ipynb_checkpoints/
*.ipynb_checkpoints

# ===== IDE =====
.vscode/settings.json
.claude/settings.local.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== OUTPUTS VOLUMINEUX =====
# Les figures PNG du mémoire sont versionnées (référencées par memoire/main.tex).
outputs/figures/*.pdf
outputs/tables/*.xlsx

# ===== LATEX (mémoire) =====
memoire/tectonic*
memoire_cascade/tectonic*
memoire_cascade/build/
memoire_cascade/*.aux
memoire_cascade/*.bbl
memoire_cascade/*.blg
memoire_cascade/*.log
memoire_cascade/*.out
memoire_cascade/*.toc
memoire/*.pdf
memoire/*.aux
memoire/*.bbl
memoire/*.bcf
memoire/*.blg
memoire/*.log
memoire/*.out
memoire/*.run.xml
memoire/*.toc

# ===== LOGS =====
*.log
logs/

# ===== ENV =====
.env
.env.local
config/secrets.yaml

# ===== ESSAI DE STYLE V2 =====
# Le PDF de l'essai de style n'est PAS versionne, contrairement a main.pdf : il
# pese 10 Mo, il se regenere en une commande, et l'essai peut etre abandonne.
# Ses SOURCES, elles, sont versionnees (main_v2.tex, preambule_v2.tex).
# Si la v2 est retenue, preambule_v2 remplace preambule et cette regle disparait.
exploratory/memoire_cascade/main_v2.pdf
